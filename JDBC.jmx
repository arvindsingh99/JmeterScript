          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC-15 TXN Step3 - Place Order">
            <stringProp name="dataSource">FreeSQLDB</stringProp>
            <stringProp name="queryType">Prepared Update Statement</stringProp>
            <stringProp name="query">INSERT INTO orders (customer_id, product_id, quantity, total_amount, status) VALUES (?, ?, ?, ?, &apos;PENDING&apos;)</stringProp>
            <stringProp name="queryArguments">${TXN_CUST_ID_1},${TXN_PROD_ID_1},${__Random(1,5,)},${TXN_PRICE_1}</stringProp>
            <stringProp name="queryArgumentsTypes">INTEGER,INTEGER,INTEGER,DECIMAL</stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout">30</stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
          </JDBCSampler>
          <hashTree>
