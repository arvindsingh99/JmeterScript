        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC-06 Sales Summary by Category" enabled="true">
          <stringProp name="dataSource">FreeSQLDB</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">SELECT p.category, COUNT(o.order_id) AS total_orders, SUM(o.quantity) AS total_qty, ROUND(SUM(o.total_amount),2) AS total_revenue, ROUND(AVG(o.total_amount),2) AS avg_order FROM orders o INNER JOIN products p ON o.product_id = p.product_id GROUP BY p.category ORDER BY total_revenue DESC</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames">CATEGORY,TOT_ORDERS,TOT_QTY,TOT_REV,AVG_ORDER</stringProp>
          <stringProp name="resultVariable">salesSummary</stringProp>
          <stringProp name="queryTimeout">30</stringProp>
          <stringProp name="resultSetMaxRows">50</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Assert - Under 15s">
            <stringProp name="DurationAssertion.duration">15000</stringProp>
          </DurationAssertion>
