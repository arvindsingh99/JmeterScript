        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC-04 Get Orders with Full Details">
          <stringProp name="dataSource">FreeSQLDB</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">SELECT o.order_id, CONCAT(c.first_name,&apos; &apos;,c.last_name) AS customer_name, c.city, p.product_name, p.category, o.quantity, o.total_amount, o.status, o.order_date FROM orders o INNER JOIN customers c ON o.customer_id = c.customer_id INNER JOIN products p ON o.product_id = p.product_id ORDER BY o.order_date DESC</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames">ORDER_ID,CUST_NAME,CITY,PROD_NAME,CATEGORY,QTY,AMOUNT,STATUS,DATE</stringProp>
          <stringProp name="resultVariable">allOrders</stringProp>
          <stringProp name="queryTimeout">30</stringProp>
          <stringProp name="resultSetMaxRows">100</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Assert - Under 15s">
            <stringProp name="DurationAssertion.duration">15000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>
